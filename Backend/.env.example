# Environment Variables for Smart Budget App
PROJECT_NAME="Smart Daily Budget & Expense Tracker (India)"
APP_ENV="development"
DEBUG=True

# Database Configuration (SQLite default for zero-config run, or PostgreSQL)
DATABASE_URL="sqlite:///./smart_budget.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_budget_db"

# Security & JWT Tokens
SECRET_KEY="super_secret_jwt_signing_key_change_in_production_min_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://10.0.2.2:8000"
